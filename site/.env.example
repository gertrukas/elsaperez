# Desarrollo local. En producción estas variables van en
# Plesk → Node.js → Environment variables de elsaurbina.com (no subas .env).

NEXT_TELEMETRY_DISABLED=1

# Se incrustan al compilar: defínelas en Plesk antes de `npm run build`.
NEXT_PUBLIC_SITE_URL=https://elsaurbina.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Servidor (route handler /api/contacto). Se leen al arrancar.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=site@elsaurbina.com
SMTP_PASS=
MAIL_FROM="Elsa Urbina <site@elsaurbina.com>"
CONTACTO_TO=
